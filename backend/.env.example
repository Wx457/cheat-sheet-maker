# Copy to .env and fill in real values (.env is git-ignored).
#
# Docker Compose injects REDIS_HOST / QDRANT_HOST etc. (service names);
# the defaults below are for running uvicorn directly on your host.

GOOGLE_API_KEY=
OPENAI_API_KEY=
# Cohere Rerank (optional: empty = retrieval without rerank)
COHERE_API_KEY=

# Non-Docker local: localhost; Docker Compose overrides to "redis" / "qdrant"
REDIS_HOST=localhost
REDIS_PORT=6379
QDRANT_HOST=localhost
QDRANT_PORT=6333

RAG_RETRY_ATTEMPTS=6
RAG_RETRY_DELAY_SECONDS=2

# Embedding sub-batching (rate-limit avoidance)
EMBEDDING_BATCH_SIZE=100
EMBEDDING_BATCH_DELAY_SECONDS=0.5

# Ingestion quota (chunks)
MAX_CHUNKS_PER_USER=500
MAX_CHUNKS_PER_INGEST=200

SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Clerk（Phase 2）：Dashboard → API Keys
CLERK_SECRET_KEY=
# Optional: JWT public key (PEM, write line breaks as the two characters \n) for networkless verification
CLERK_JWT_KEY=
# Allowed token origins (azp), comma-separated: webapp origin + chrome-extension://<extension id>
CLERK_AUTHORIZED_PARTIES=http://localhost:3000,chrome-extension://
# Clerk user ids allowed to call POST /api/rag/clear (wipes ALL users), comma-separated; empty = disabled
ADMIN_USER_IDS=
